// Cloudflare 배포 설정: 이 폴더 = Cloudflare Worker 'date-calc' 하나
// 주소: https://date.lumenlab.page (메인 lumenlab.page 는 루멘랩 소개 사이트 = lumenlab 폴더). 예전 주소 date-calc.mysitebox.workers.dev 도 계속 열림
// 빌드 없음. 이 폴더 파일이 그대로 사이트가 된다. 올리지 않을 파일은 .assetsignore 에 적는다.
{
  "name": "date-calc",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "." },
  // routes가 있으면 wrangler가 workers.dev 주소를 꺼 버린다. 예전 주소를 살려 두려고 명시
  "workers_dev": true,
  "routes": [
    { "pattern": "date.lumenlab.page", "custom_domain": true }
  ]
}
