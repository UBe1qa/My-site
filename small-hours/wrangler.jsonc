// Cloudflare 배포 설정: 이 폴더 = Cloudflare Worker 'small-hours' 하나 (가상 문페이즈 시계 브랜드 견본 사이트)
// 주소: https://small-hours.lumenlab.page . workers.dev 주소는 worker.js 가 대표 주소로 301 넘긴다.
// 빌드된 파일(assets/app.js)을 그대로 올린다. 고칠 땐 _dev/src 를 고치고 _dev/build.sh 로 다시 만든다.
// 배포는 GitHub Actions(.github/workflows/deploy-new-sites.yml)가 한다 (.deploy-actions 표시).
{
  "name": "small-hours",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/assets/*", "!/img/*"]
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "small-hours.lumenlab.page", "custom_domain": true }
  ]
}
