 "main_line": [
  {
   "ply": 1,
   "san": "e4",
   "why_en": "Takes the center, opens lines for the queen and the light-squared bishop.",
   "why_ko": "중앙을 잡고, 퀸과 밝은 칸 비숍의 길을 열어요."
  },
  {
   "ply": 2,
   "san": "c5",
   "why_en": "Fights for d4 from the side and makes the game unbalanced from move one.",
   "why_ko": "옆에서 d4를 다투고, 첫 수부터 판의 균형을 깨요."
  },
  {
   "ply": 3,
   "san": "Nf3",
   "why_en": "Develops and prepares d4, the most common plan against the Sicilian.",
   "why_ko": "전개하면서 d4를 준비해요. 시실리안에 가장 흔한 계획이에요."
  },
  {
   "ply": 4,
   "san": "d6",
   "why_en": "Covers e5 and keeps the knight out of e5 and the bishop’s path open.",
   "why_ko": "e5를 막아 나이트가 못 오게 하고, 비숍 길을 열어요."
  },
  {
   "ply": 5,
   "san": "d4",
   "why_en": "Opens the center; White gets a lead in development and more space.",
   "why_ko": "중앙을 열어요. 백은 전개가 앞서고 공간이 넓어져요."
  },
  {
   "ply": 6,
   "san": "cxd4",
   "why_en": "Trades a wing pawn for a center pawn, which gives Black two central pawns.",
   "why_ko": "옆 폰을 중앙 폰과 바꿔, 흑에게 중앙 폰 두 개가 남아요."
  },
  {
   "ply": 7,
   "san": "Nxd4",
   "why_en": "Recaptures with the knight, which now sits in the middle of the board.",
   "why_ko": "나이트로 다시 잡아요. 나이트가 판 한가운데에 서요."
  },
  {
   "ply": 8,
   "san": "Nf6",
   "why_en": "Develops with an attack on e4, so White has to defend it.",
   "why_ko": "e4를 치며 전개해 백이 지키게 만들어요."
  },
  {
   "ply": 9,
   "san": "Nc3",
   "why_en": "Defends e4 with a piece and develops.",
   "why_ko": "기물로 e4를 지키면서 전개해요."
  },
  {
   "ply": 10,
   "san": "e6",
   "why_en": "Builds a compact center with pawns on d6 and e6 and opens the bishop.",
   "why_ko": "d6·e6 폰으로 작고 단단한 중앙을 만들고 비숍 길을 열어요."
  },
  {
   "ply": 11,
   "san": "g4",
   "why_en": "Throws the g-pawn forward to kick the f6 knight: the Keres Attack.",
   "why_ko": "g폰을 올려 f6 나이트를 쫓아요(케레스 어택)."
  },
  {
   "ply": 12,
   "san": "h6",
   "why_en": "Stops g5 for now.",
   "why_ko": "당장은 g5를 막아요."
  },
  {
   "ply": 13,
   "san": "h4",
   "why_en": "Prepares g5 anyway.",
   "why_ko": "그래도 g5를 준비해요."
  },
  {
   "ply": 14,
   "san": "Nc6",
   "why_en": "Develops and hits d4.",
   "why_ko": "전개하며 d4를 쳐요."
  },
  {
   "ply": 15,
   "san": "Rg1",
   "why_en": "Supports g5 with the rook.",
   "why_ko": "룩으로 g5를 받쳐요."
  },
  {
   "ply": 16,
   "san": "d5",
   "why_en": "Strikes in the center while White’s pieces are on the kingside.",
   "why_ko": "백 기물이 킹 쪽에 몰린 틈에 중앙을 쳐요."
  }
 ],
