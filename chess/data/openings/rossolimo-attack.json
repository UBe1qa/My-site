 "main_line": [
  {
   "ply": 1,
   "san": "e4",
   "why_en": "Takes the center, opens lines for the queen and the light-squared bishop.",
   "why_ko": "중앙을 잡고, 퀸과 밝은 칸 비숍의 길을 열어요."
  },
  {
   "ply": 2,
   "san": "c5",
   "why_en": "Fights for d4 from the side and makes the game unbalanced from move one.",
   "why_ko": "옆에서 d4를 다투고, 첫 수부터 판의 균형을 깨요."
  },
  {
   "ply": 3,
   "san": "Nf3",
   "why_en": "Develops and prepares d4, the most common plan against the Sicilian.",
   "why_ko": "전개하면서 d4를 준비해요. 시실리안에 가장 흔한 계획이에요."
  },
  {
   "ply": 4,
   "san": "Nc6",
   "why_en": "Develops and adds a second guard of d4 and e5.",
   "why_ko": "전개하면서 d4·e5를 한 번 더 막아요."
  },
  {
   "ply": 5,
   "san": "Bb5",
   "why_en": "Pins the c6 knight and may take it to double Black’s pawns.",
   "why_ko": "c6 나이트를 묶고, 잡아서 흑 폰을 겹치게 할 수도 있어요."
  },
  {
   "ply": 6,
   "san": "e6",
   "why_en": "Prepares ...Nge7 so the c6 knight is supported.",
   "why_ko": "...Nge7을 준비해 c6 나이트를 받쳐요."
  },
  {
   "ply": 7,
   "san": "O-O",
   "why_en": "Castles.",
   "why_ko": "캐슬링해요."
  },
  {
   "ply": 8,
   "san": "Nge7",
   "why_en": "Supports c6 with the other knight.",
   "why_ko": "다른 나이트로 c6를 받쳐요."
  },
  {
   "ply": 9,
   "san": "Re1",
   "why_en": "Puts the rook on the e-file and prepares d4.",
   "why_ko": "룩을 e파일에 두고 d4를 준비해요."
  },
  {
   "ply": 10,
   "san": "a6",
   "why_en": "Asks the bishop to decide.",
   "why_ko": "비숍에게 정하라고 물어요."
  },
  {
   "ply": 11,
   "san": "Bf1",
   "why_en": "The bishop drops back to f1, keeping it.",
   "why_ko": "비숍을 f1로 물려 남겨 둬요."
  },
  {
   "ply": 12,
   "san": "d5",
   "why_en": "Takes the center.",
   "why_ko": "중앙을 잡아요."
  },
  {
   "ply": 13,
   "san": "exd5",
   "why_en": "Trades in the center.",
   "why_ko": "중앙에서 바꿔요."
  },
  {
   "ply": 14,
   "san": "Nxd5",
   "why_en": "Recaptures with the knight in the center.",
