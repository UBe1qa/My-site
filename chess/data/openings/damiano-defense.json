 "main_line": [
  {
   "ply": 1,
   "san": "e4",
   "why_en": "Takes the center, opens lines for the queen and the light-squared bishop.",
   "why_ko": "중앙을 잡고, 퀸과 밝은 칸 비숍의 길을 열어요."
  },
  {
   "ply": 2,
   "san": "e5",
   "why_en": "Black takes an equal share of the center and opens lines for the queen and bishop.",
   "why_ko": "흑도 중앙을 같이 잡고 퀸과 비숍의 길을 열어요."
  },
  {
   "ply": 3,
   "san": "Nf3",
   "why_en": "Develops with an attack on e5, so Black must spend the next move guarding it.",
   "why_ko": "e5를 치며 전개해요. 흑은 다음 수로 e5를 지켜야 해요."
  },
  {
   "ply": 4,
   "san": "f6",
   "why_en": "Guards e5 with the f-pawn, which takes f6 from the knight and weakens the king.",
   "why_ko": "f폰으로 e5를 지키지만, 나이트 칸 f6을 뺏고 킹이 약해져요."
  },
  {
   "ply": 5,
   "san": "Nxe5",
   "why_en": "Takes the pawn anyway: 3...fxe5? 4.Qh5+ wins for White.",
   "why_ko": "그래도 폰을 잡아요. 3...fxe5?는 4.Qh5+로 백이 이겨요."
  },
  {
   "ply": 6,
   "san": "Qe7",
   "why_en": "Hits the knight instead of taking it.",
   "why_ko": "나이트를 잡지 않고 쳐요."
  },
  {
   "ply": 7,
   "san": "Nf3",
   "why_en": "The knight goes back home.",
   "why_ko": "나이트가 제자리로 돌아가요."
  },
  {
   "ply": 8,
   "san": "Qxe4+",
   "why_en": "Wins back the pawn with check.",
   "why_ko": "체크하며 폰을 되찾아요."
  },
  {
   "ply": 9,
   "san": "Be2",
   "why_en": "Blocks the check; White is ahead in development.",
   "why_ko": "체크를 막아요. 백 전개가 앞서요."
