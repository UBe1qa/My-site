  },
  {
   "ply": 7,
   "san": "Ng5",
   "why_en": "Attacks f7 with two pieces at once.",
   "why_ko": "두 기물로 한꺼번에 f7을 쳐요."
  },
  {
   "ply": 8,
   "san": "d5",
   "why_en": "Blocks the bishop’s path to f7.",
   "why_ko": "비숍이 f7로 가는 길을 막아요."
  },
  {
   "ply": 9,
   "san": "exd5",
   "why_en": "Takes the pawn and opens the bishop again.",
   "why_ko": "폰을 잡아 비숍 길을 다시 열어요."
  },
  {
   "ply": 10,
   "san": "Na5",
   "why_en": "Hits the bishop; 5...Nxd5? lets White hit f7 with Nxf7 or d4.",
