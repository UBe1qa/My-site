  },
  {
   "ply": 3,
   "san": "Nf3",
   "why_en": "Develops with an attack on e5, so Black must spend the next move guarding it.",
   "why_ko": "e5를 치며 전개해요. 흑은 다음 수로 e5를 지켜야 해요."
  },
  {
   "ply": 4,
   "san": "Nc6",
   "why_en": "Defends e5 with a piece and develops at the same time.",
   "why_ko": "기물로 e5를 지키면서 전개해요."
  },
  {
   "ply": 5,
   "san": "Bc4",
   "why_en": "The bishop aims at f7, the weak square that only the black king defends.",
   "why_ko": "비숍이 f7을 겨눠요. f7은 흑 킹 혼자 지키는 약한 칸이에요."
  },
  {
   "ply": 6,
   "san": "Nf6",
   "why_en": "Counter-attacks e4 instead of copying White with ...Bc5.",
