  },
  {
   "ply": 3,
   "san": "Nf3",
   "why_en": "Develops with an attack on e5, so Black must spend the next move guarding it.",
   "why_ko": "e5를 치며 전개해요. 흑은 다음 수로 e5를 지켜야 해요."
  },
  {
   "ply": 4,
   "san": "Nc6",
   "why_en": "Defends e5 with a piece and develops at the same time.",
   "why_ko": "기물로 e5를 지키면서 전개해요."
  },
  {
   "ply": 5,
   "san": "Bc4",
   "why_en": "The bishop aims at f7, the weak square that only the black king defends.",
   "why_ko": "비숍이 f7을 겨눠요. f7은 흑 킹 혼자 지키는 약한 칸이에요."
  },
  {
   "ply": 6,
   "san": "Bc5",
   "why_en": "Copies White: the bishop aims at f2 and controls d4.",
   "why_ko": "백을 따라 둬요. 비숍이 f2를 겨누고 d4를 막아요."
  },
  {
   "ply": 7,
   "san": "c3",
   "why_en": "Prepares d4, so that White can build a full pawn center.",
   "why_ko": "d4를 준비해 폰으로 중앙을 꽉 채우려 해요."
  },
  {
   "ply": 8,
   "san": "Nf6",
   "why_en": "Develops with an attack on e4 and keeps an eye on d4.",
   "why_ko": "e4를 치며 전개하고 d4도 지켜봐요."
  },
  {
   "ply": 9,
   "san": "d3",
   "why_en": "Protects e4 calmly; the d4 push is kept for later.",
   "why_ko": "e4를 차분히 지켜요. d4는 나중으로 미뤄요."
  },
  {
   "ply": 10,
   "san": "d6",
   "why_en": "Supports e5 and opens the c8 bishop.",
   "why_ko": "e5를 받치고 c8 비숍 길을 열어요."
  },
  {
   "ply": 11,
   "san": "O-O",
   "why_en": "Castles; the king is safe and the rook can come to e1.",
   "why_ko": "캐슬링해요. 킹이 안전해지고 룩이 e1로 갈 수 있어요."
  },
  {
   "ply": 12,
   "san": "O-O",
   "why_en": "Black castles too; both kings are safe and the slow maneuvering starts.",
   "why_ko": "흑도 캐슬링해요. 양쪽 킹이 안전하고 느린 기물 돌리기가 시작돼요."
