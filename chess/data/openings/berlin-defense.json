 "main_line": [
  {
   "ply": 1,
   "san": "e4",
   "why_en": "Takes the center, opens lines for the queen and the light-squared bishop.",
   "why_ko": "중앙을 잡고, 퀸과 밝은 칸 비숍의 길을 열어요."
  },
  {
   "ply": 2,
   "san": "e5",
   "why_en": "Black takes an equal share of the center and opens lines for the queen and bishop.",
   "why_ko": "흑도 중앙을 같이 잡고 퀸과 비숍의 길을 열어요."
  },
  {
   "ply": 3,
   "san": "Nf3",
   "why_en": "Develops with an attack on e5, so Black must spend the next move guarding it.",
   "why_ko": "e5를 치며 전개해요. 흑은 다음 수로 e5를 지켜야 해요."
  },
  {
   "ply": 4,
   "san": "Nc6",
   "why_en": "Defends e5 with a piece and develops at the same time.",
   "why_ko": "기물로 e5를 지키면서 전개해요."
  },
  {
   "ply": 5,
   "san": "Bb5",
   "why_en": "Attacks the knight that guards e5, building slow pressure on Black’s center.",
   "why_ko": "e5를 지키는 나이트를 쳐서 흑 중앙에 느린 압박을 쌓아요."
  },
  {
   "ply": 6,
   "san": "Nf6",
   "why_en": "Counter-attacks e4, the Berlin: Black is ready to give up the e5 pawn for a while.",
   "why_ko": "e4를 되쳐요(베를린). 흑은 잠시 e5 폰을 내줄 생각이에요."
  },
  {
   "ply": 7,
   "san": "O-O",
   "why_en": "Castles and lets Black take e4.",
   "why_ko": "캐슬링하며 흑이 e4를 잡게 둬요."
  },
  {
   "ply": 8,
   "san": "Nxe4",
   "why_en": "Takes the pawn.",
   "why_ko": "폰을 잡아요."
  },
  {
   "ply": 9,
   "san": "d4",
   "why_en": "Opens the center to make use of the black king in the middle.",
   "why_ko": "흑 킹이 가운데 있는 틈에 중앙을 열어요."
  },
  {
   "ply": 10,
   "san": "Nd6",
   "why_en": "Hits the bishop and keeps an eye on e5.",
   "why_ko": "비숍을 치며 e5도 지켜봐요."
  },
  {
   "ply": 11,
   "san": "Bxc6",
   "why_en": "Trades the bishop before it is lost.",
   "why_ko": "비숍을 잃기 전에 바꿔요."
  },
  {
   "ply": 12,
   "san": "dxc6",
   "why_en": "Recaptures toward the center and opens the c8 bishop.",
   "why_ko": "중앙 쪽으로 다시 잡고 c8 비숍 길을 열어요."
  },
  {
   "ply": 13,
   "san": "dxe5",
   "why_en": "Takes the pawn and hits the knight.",
   "why_ko": "폰을 잡으며 나이트를 쳐요."
  },
  {
   "ply": 14,
   "san": "Nf5",
   "why_en": "The knight goes to f5.",
   "why_ko": "나이트가 f5로 가요."
  },
  {
   "ply": 15,
   "san": "Qxd8+",
   "why_en": "Trades queens; this is the famous Berlin endgame.",
   "why_ko": "퀸을 바꿔요. 유명한 베를린 엔드게임이에요."
  },
  {
   "ply": 16,
   "san": "Kxd8",
   "why_en": "The king recaptures: no castling, but no queens and two bishops.",
   "why_ko": "킹으로 다시 잡아요. 캐슬링은 못 하지만 퀸이 없고 비숍이 둘이에요."
  }
 ],
