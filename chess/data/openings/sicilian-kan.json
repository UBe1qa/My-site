 "main_line": [
  {
   "ply": 1,
   "san": "e4",
   "why_en": "Takes the center, opens lines for the queen and the light-squared bishop.",
   "why_ko": "중앙을 잡고, 퀸과 밝은 칸 비숍의 길을 열어요."
  },
  {
   "ply": 2,
   "san": "c5",
   "why_en": "Fights for d4 from the side and makes the game unbalanced from move one.",
   "why_ko": "옆에서 d4를 다투고, 첫 수부터 판의 균형을 깨요."
  },
  {
   "ply": 3,
   "san": "Nf3",
   "why_en": "Develops and prepares d4, the most common plan against the Sicilian.",
   "why_ko": "전개하면서 d4를 준비해요. 시실리안에 가장 흔한 계획이에요."
  },
  {
   "ply": 4,
   "san": "e6",
   "why_en": "Opens the f8 bishop and keeps the d-pawn free to choose later.",
   "why_ko": "f8 비숍 길을 열고, d폰은 나중에 정하도록 남겨요."
  },
  {
   "ply": 5,
   "san": "d4",
   "why_en": "Opens the center to get a knight to d4.",
   "why_ko": "중앙을 열어 나이트를 d4에 세우려 해요."
  },
  {
   "ply": 6,
   "san": "cxd4",
   "why_en": "Trades the c-pawn for White’s d-pawn.",
   "why_ko": "c폰을 백 d폰과 바꿔요."
  },
  {
   "ply": 7,
   "san": "Nxd4",
   "why_en": "Recaptures with the knight in the center.",
   "why_ko": "나이트로 다시 잡아 중앙에 세워요."
  },
  {
   "ply": 8,
   "san": "a6",
   "why_en": "Takes b5 from the knight and bishop and prepares ...Qc7 and ...b5.",
   "why_ko": "나이트·비숍이 b5에 못 오게 하고 ...Qc7·...b5를 준비해요."
  },
  {
   "ply": 9,
   "san": "Bd3",
   "why_en": "Protects e4 with the bishop and keeps c2–c4 possible.",
   "why_ko": "비숍으로 e4를 지키고 c2–c4를 남겨요."
  },
  {
   "ply": 10,
   "san": "Bc5",
   "why_en": "Hits the d4 knight.",
   "why_ko": "d4 나이트를 쳐요."
  },
  {
   "ply": 11,
   "san": "Nb3",
   "why_en": "The knight drops back to b3, hitting the bishop.",
   "why_ko": "나이트가 b3로 물러나며 비숍을 쳐요."
  },
  {
   "ply": 12,
   "san": "Ba7",
   "why_en": "The bishop goes to a7, still aiming at f2.",
   "why_ko": "비숍이 a7로 가도 여전히 f2를 겨눠요."
  },
  {
   "ply": 13,
   "san": "Qe2",
   "why_en": "Protects e4 and prepares to castle.",
   "why_ko": "e4를 지키고 캐슬링을 준비해요."
  },
  {
   "ply": 14,
   "san": "Ne7",
   "why_en": "Develops the knight to e7 so the bishop’s diagonal stays open.",
   "why_ko": "비숍 대각선을 막지 않게 나이트를 e7로 꺼내요."
  }
