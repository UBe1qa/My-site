 "main_line": [
  {
   "ply": 1,
   "san": "e4",
   "why_en": "Takes the center, opens lines for the queen and the light-squared bishop.",
   "why_ko": "중앙을 잡고, 퀸과 밝은 칸 비숍의 길을 열어요."
  },
  {
   "ply": 2,
   "san": "e5",
   "why_en": "Black takes an equal share of the center and opens lines for the queen and bishop.",
   "why_ko": "흑도 중앙을 같이 잡고 퀸과 비숍의 길을 열어요."
  },
  {
   "ply": 3,
   "san": "Nf3",
   "why_en": "Develops with an attack on e5, so Black must spend the next move guarding it.",
   "why_ko": "e5를 치며 전개해요. 흑은 다음 수로 e5를 지켜야 해요."
  },
  {
   "ply": 4,
   "san": "Nc6",
   "why_en": "Defends e5 with a piece and develops at the same time.",
   "why_ko": "기물로 e5를 지키면서 전개해요."
  },
  {
   "ply": 5,
   "san": "Bc4",
   "why_en": "The bishop aims at f7, the weak square that only the black king defends.",
   "why_ko": "비숍이 f7을 겨눠요. f7은 흑 킹 혼자 지키는 약한 칸이에요."
  },
  {
   "ply": 6,
   "san": "Bc5",
   "why_en": "Copies White: the bishop aims at f2 and controls d4.",
   "why_ko": "백을 따라 둬요. 비숍이 f2를 겨누고 d4를 막아요."
  },
  {
   "ply": 7,
   "san": "b4",
   "why_en": "Offers the b-pawn so that c3 and d4 come with gain of time.",
   "why_ko": "b폰을 내밀어, 뒤에 c3·d4를 시간을 벌며 둬요."
  },
  {
   "ply": 8,
   "san": "Bxb4",
   "why_en": "Takes the pawn.",
   "why_ko": "폰을 잡아요."
  },
  {
   "ply": 9,
   "san": "c3",
   "why_en": "Hits the bishop and prepares d4.",
   "why_ko": "비숍을 치고 d4를 준비해요."
  },
  {
   "ply": 10,
   "san": "Ba5",
   "why_en": "The bishop goes to a5, where it pins c3 after d4.",
   "why_ko": "비숍이 a5로 가요. d4 뒤에는 c3를 묶어요."
  },
  {
   "ply": 11,
   "san": "d4",
   "why_en": "Opens the center while Black is behind in development.",
   "why_ko": "흑 전개가 늦은 틈에 중앙을 열어요."
  },
  {
   "ply": 12,
   "san": "exd4",
   "why_en": "Takes another pawn.",
   "why_ko": "폰을 하나 더 잡아요."
  },
  {
   "ply": 13,
   "san": "O-O",
   "why_en": "Castles and gives even more for a fast attack.",
   "why_ko": "캐슬링하며 더 내주고 빠르게 공격해요."
  }
 ],
