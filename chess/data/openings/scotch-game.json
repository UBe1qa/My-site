 "main_line": [
  {
   "ply": 1,
   "san": "e4",
   "why_en": "Takes the center, opens lines for the queen and the light-squared bishop.",
   "why_ko": "중앙을 잡고, 퀸과 밝은 칸 비숍의 길을 열어요."
  },
  {
   "ply": 2,
   "san": "e5",
   "why_en": "Black takes an equal share of the center and opens lines for the queen and bishop.",
   "why_ko": "흑도 중앙을 같이 잡고 퀸과 비숍의 길을 열어요."
  },
  {
   "ply": 3,
   "san": "Nf3",
   "why_en": "Develops with an attack on e5, so Black must spend the next move guarding it.",
   "why_ko": "e5를 치며 전개해요. 흑은 다음 수로 e5를 지켜야 해요."
  },
  {
   "ply": 4,
   "san": "Nc6",
   "why_en": "Defends e5 with a piece and develops at the same time.",
   "why_ko": "기물로 e5를 지키면서 전개해요."
  },
  {
   "ply": 5,
   "san": "d4",
   "why_en": "Opens the center straight away before Black has finished developing.",
   "why_ko": "흑이 전개를 마치기 전에 바로 중앙을 열어요."
  },
  {
   "ply": 6,
   "san": "exd4",
   "why_en": "Takes the pawn; holding e5 with ...d6 would be passive.",
   "why_ko": "폰을 잡아요. ...d6로 e5를 붙잡으면 수동적이에요."
  },
  {
   "ply": 7,
   "san": "Nxd4",
   "why_en": "Recaptures with the knight, now strong on d4.",
   "why_ko": "나이트로 다시 잡아 d4에 단단히 세워요."
  },
  {
   "ply": 8,
   "san": "Nf6",
   "why_en": "Develops with an attack on e4.",
   "why_ko": "e4를 치며 전개해요."
  },
  {
   "ply": 9,
   "san": "Nxc6",
   "why_en": "Trades knights so that e5 comes with tempo.",
   "why_ko": "나이트를 바꿔 다음에 e5를 시간을 벌며 둬요."
  },
  {
   "ply": 10,
   "san": "bxc6",
   "why_en": "Recaptures toward the center; Black gets the b-file and a strong d-pawn later.",
   "why_ko": "중앙 쪽으로 다시 잡아요. 흑은 b파일과 나중에 강한 d폰을 얻어요."
  },
  {
   "ply": 11,
   "san": "e5",
   "why_en": "Kicks the f6 knight and grabs space.",
   "why_ko": "f6 나이트를 쫓고 공간을 잡아요."
  },
  {
   "ply": 12,
   "san": "Qe7",
   "why_en": "Pins the e5 pawn to the white king so the knight is safe on d5.",
   "why_ko": "e5 폰을 백 킹 앞에 묶어 나이트가 d5에 안전하게 해요."
  },
  {
   "ply": 13,
