 "main_line": [
  {
   "ply": 1,
   "san": "e4",
   "why_en": "Takes the center, opens lines for the queen and the light-squared bishop.",
   "why_ko": "중앙을 잡고, 퀸과 밝은 칸 비숍의 길을 열어요."
  },
  {
   "ply": 2,
   "san": "e5",
   "why_en": "Black takes an equal share of the center and opens lines for the queen and bishop.",
   "why_ko": "흑도 중앙을 같이 잡고 퀸과 비숍의 길을 열어요."
  },
  {
   "ply": 3,
   "san": "Nf3",
   "why_en": "Develops with an attack on e5, so Black must spend the next move guarding it.",
   "why_ko": "e5를 치며 전개해요. 흑은 다음 수로 e5를 지켜야 해요."
  },
  {
   "ply": 4,
   "san": "Nc6",
   "why_en": "Defends e5 with a piece and develops at the same time.",
   "why_ko": "기물로 e5를 지키면서 전개해요."
  },
  {
   "ply": 5,
   "san": "Bb5",
   "why_en": "Attacks the knight that guards e5, building slow pressure on Black’s center.",
   "why_ko": "e5를 지키는 나이트를 쳐서 흑 중앙에 느린 압박을 쌓아요."
  },
  {
   "ply": 6,
   "san": "a6",
   "why_en": "Asks the bishop at once whether it wants to take on c6 or retreat.",
   "why_ko": "비숍에게 바로 c6를 잡을지 물러날지 물어요."
  },
  {
   "ply": 7,
   "san": "Ba4",
   "why_en": "Keeps the bishop and the pin on the c6 knight; taking on c6 is the Exchange Variation.",
   "why_ko": "비숍을 지키며 c6 나이트 압박을 이어요. c6를 잡으면 익스체인지 변화예요."
  },
  {
   "ply": 8,
   "san": "Nf6",
   "why_en": "Develops with an attack on e4.",
   "why_ko": "e4를 치며 전개해요."
  },
  {
   "ply": 9,
   "san": "O-O",
   "why_en": "Castles: e4 can be left hanging, because ...Nxe4 runs into Re1.",
   "why_ko": "캐슬링해요. ...Nxe4는 Re1에 걸리므로 e4를 그냥 둬도 돼요."
  },
  {
   "ply": 10,
   "san": "Be7",
   "why_en": "Develops quietly and prepares to castle; this is the Closed Ruy Lopez.",
   "why_ko": "조용히 전개하고 캐슬링을 준비해요. 클로즈드 루이 로페즈예요."
  },
  {
   "ply": 11,
   "san": "Re1",
   "why_en": "Defends e4 for real, so the threat Bxc6 and Nxe5 is now on.",
   "why_ko": "이제 e4를 지켜요. 그래서 Bxc6 뒤 Nxe5가 진짜 위협이 돼요."
  },
  {
   "ply": 12,
   "san": "b5",
   "why_en": "Chases the bishop away to end the pressure on c6 for good.",
   "why_ko": "비숍을 쫓아 c6 압박을 아예 끝내요."
  },
  {
   "ply": 13,
   "san": "Bb3",
   "why_en": "The bishop drops back to b3 and still aims at f7.",
   "why_ko": "비숍이 b3로 물러나도 여전히 f7을 겨눠요."
  },
  {
   "ply": 14,
   "san": "d6",
   "why_en": "Supports e5 and opens the c8 bishop.",
   "why_ko": "e5를 받치고 c8 비숍 길을 열어요."
  },
  {
   "ply": 15,
   "san": "c3",
   "why_en": "Prepares d4 and keeps a retreat on c2 for the bishop.",
   "why_ko": "d4를 준비하고 비숍이 c2로 물러날 길을 만들어요."
  },
  {
   "ply": 16,
   "san": "O-O",
   "why_en": "Black castles; ...Na5 or ...Bb7 come next.",
   "why_ko": "흑이 캐슬링해요. 다음은 ...Na5나 ...Bb7이에요."
  },
  {
   "ply": 17,
   "san": "h3",
   "why_en": "Stops ...Bg4, so that d4 can follow without a pin on the f3 knight.",
   "why_ko": "...Bg4를 막아, f3 나이트가 묶이지 않은 채 d4를 둘 수 있게 해요."
  }
 ],
