// Cloudflare 배포 설정: 이 폴더 = Cloudflare Worker 'qr' 하나 (오래QR / Staycode, 무료 QR코드 생성기)
// 주소: https://qr.lumenlab.page (영어 /, 한국어 /ko/). workers.dev 주소는 켜지 않는다(같은 내용이 두 주소에 생기지 않게).
// 빌드 없음. 이 폴더 파일이 그대로 사이트가 된다. 올리지 않을 파일은 .assetsignore 에 적는다.
// 배포는 GitHub Actions(.github/workflows/deploy-new-sites.yml)가 한다 (.deploy-actions 표시).
{
  "name": "qr",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    // 없는 주소는 404.html(광고 없음, noindex)을 404로 보여 준다
    "not_found_handling": "404-page",
    // 폴더 주소 끝에 / 를 붙이고 .html 을 뗀 주소로 넘긴다
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "qr.lumenlab.page", "custom_domain": true }
  ]
}
