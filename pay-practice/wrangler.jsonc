// Cloudflare 배포 설정: 이 폴더 = Cloudflare Worker 'pay-practice' 하나
// 화면 파일은 이 폴더 그대로 올라가고(빌드 없음), /api/ 로 시작하는 주소만 worker.js(서버 코드)가 처리해요.
// 사이트에 올리지 않을 파일은 .assetsignore 에 적어요. (worker.js 는 서버 코드라 화면 파일로 올리지 않아요)
{
  "name": "pay-practice",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
